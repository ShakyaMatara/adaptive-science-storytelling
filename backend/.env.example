# Copy this file to ".env" and fill in your values.
# The real .env is git-ignored — never commit your API key.

# --- LLM provider (any OpenAI-compatible proxy/API) ---
# Switch providers by editing these values ONLY — no code changes.
# See core/llm_config.py for details.
PROXY_URL=https://openrouter.ai/api/v1
MODEL=meta-llama/llama-3.3-70b-instruct:free
API_KEY=

# PROVIDER EXAMPLES:
#
# OpenRouter — https://openrouter.ai  (keys: https://openrouter.ai/keys)
#   PROXY_URL=https://openrouter.ai/api/v1
#   MODEL=google/gemini-2.5-flash-lite   (or e.g. openai/gpt-5.4-mini)
#   API_KEY=sk-or-...
#
# Chutes — https://chutes.ai  (list models: GET https://llm.chutes.ai/v1/models)
#   PROXY_URL=https://llm.chutes.ai/v1
#   MODEL=<a model id from the list above>
#   API_KEY=cpk_...
#
# PROXY_URL may be the base URL (".../v1") or the full ".../v1/chat/completions"
# endpoint — the "/chat/completions" suffix is stripped automatically.

# true  -> use built-in canned content (no network or key needed; good for demos)
# false -> call the real model via the provider above
USE_MOCK_LLM=false

# --- Django ---
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Leave EMPTY here — this file is committed. The app falls back to an
# obviously-insecure placeholder for local development and refuses to start
# with DEBUG=False until a real key is set.
SECRET_KEY=
